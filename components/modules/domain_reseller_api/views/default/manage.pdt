<?php
$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('DomainResellerApi.add_module_row', true),
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/addrow/' . ($module->id ?? null)]
    ]
]);
if (method_exists($this->Widget, 'setBodyWrapper')) {
    $this->Widget->setBodyWrapper(false);
}
$this->Widget->create(
    $this->_('AdminCompanyModules.manage.boxtitle_manage', true, $this->Html->safe($module->name ?? '', true)),
    ['id' => 'manage_domain_reseller_api']
);

$rows = array_values((array) ($module->rows ?? []));
if (!empty($rows)) {
?>
<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th><?php $this->_('DomainResellerApi.manage.module_rows_heading.label'); ?></th>
            <th><?php $this->_('DomainResellerApi.manage.module_rows_heading.api_url'); ?></th>
            <th><?php $this->_('DomainResellerApi.manage.module_rows_heading.mode'); ?></th>
            <th><?php $this->_('DomainResellerApi.manage.module_rows_heading.balance'); ?></th>
            <th><?php $this->_('DomainResellerApi.manage.module_rows_heading.options'); ?></th>
        </tr>
    </thead>
    <tbody>
        <?php
        foreach ($rows as $row) {
            $wallet = $balances[$row->id] ?? null;
        ?>
        <tr>
            <td><?php echo $this->Html->safe($row->meta->label ?? ''); ?></td>
            <td><?php echo $this->Html->safe($row->meta->api_url ?? ''); ?></td>
            <td>
                <?php if (($row->meta->sandbox ?? 'false') == 'true') { ?>
                <span class="badge bg-warning text-dark badge-warning"><?php $this->_('DomainResellerApi.manage.mode_sandbox'); ?></span>
                <?php } else { ?>
                <span class="badge bg-success badge-success"><?php $this->_('DomainResellerApi.manage.mode_live'); ?></span>
                <?php } ?>
            </td>
            <td>
                <?php
                if ($wallet !== null && isset($wallet['balance'])) {
                    echo $this->Html->safe(number_format((float) $wallet['balance'], 2) . ' ' . ($wallet['currency'] ?? 'EUR'));
                    if (!empty($wallet['postpaid'])) {
                        echo ' ';
                        $this->_('DomainResellerApi.manage.postpaid');
                    }
                } else {
                    $this->_('DomainResellerApi.manage.balance_unavailable');
                }
                ?>
            </td>
            <td class="text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'settings/company/modules/editrow/' . ($module->id ?? null) . '/' . $row->id . '/'); ?>"><?php $this->_('DomainResellerApi.manage.module_rows.edit'); ?></a>
                <?php
                $this->Form->create($this->base_uri . 'settings/company/modules/deleterow/', ['class' => 'd-inline']);
                $this->Form->fieldHidden('id', $module->id ?? null);
                $this->Form->fieldHidden('row_id', $row->id);
                ?>
                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm(<?php echo $this->Html->safe(json_encode($this->_('DomainResellerApi.manage.module_rows.confirm_delete', true))); ?>);"><?php $this->_('DomainResellerApi.manage.module_rows.delete'); ?></button>
                <?php
                $this->Form->end();
                ?>
            </td>
        </tr>
        <?php
        }
        ?>
    </tbody>
</table>
<?php
} else {
?>
<div class="empty_section p-4 text-center text-muted">
    <div class="empty_box"><?php $this->_('DomainResellerApi.manage.module_rows_no_results'); ?></div>
</div>
<?php
}

$this->Widget->end();
