<?php
$status = $info['status'] ?? '';
$has_action = false;
?>
<div class="domain-reseller-api">
    <h6 class="form-section-header"><?php $this->_('DomainResellerApi.tab_actions.heading'); ?></h6>
    <p>
        <strong><?php $this->_('DomainResellerApi.tab_settings.status'); ?>:</strong>
        <?php
        echo $this->Html->safe($this->_('DomainResellerApi.status.' . $status, true) ?: $status);
        if (!empty($state['description'])) {
            echo ' &ndash; ' . $this->Html->safe($state['description']);
        }
        ?>
    </p>

    <?php
    $actions = [
        'restore' => ['canRestore', 'btn-primary'],
        'cancel_delete' => ['canCancelDelete', 'btn-primary'],
        'schedule_delete' => ['canScheduleDelete', 'btn-outline-danger']
    ];
    foreach ($actions as $action => list($flag, $class)) {
        if (empty($state[$flag])) {
            continue;
        }
        $has_action = true;
    ?>
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-2"><?php $this->_('DomainResellerApi.tab_actions.' . $action . '_description'); ?></p>
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', $action);
            $this->Form->fieldSubmit($action, $this->_('DomainResellerApi.tab_actions.field_' . $action, true), ['class' => 'btn ' . $class]);
            $this->Form->end();
            ?>
        </div>
    </div>
    <?php
    }

    if (!empty($state['canDeleteImmediate'])) {
        $has_action = true;
    ?>
    <div class="card border-danger mb-3">
        <div class="card-body">
            <p class="mb-2"><?php $this->_('DomainResellerApi.tab_actions.delete_immediate_description'); ?></p>
            <?php
            $this->Form->create();
            $this->Form->fieldHidden('action', 'delete_immediate');
            ?>
            <div class="mb-3">
                <?php $this->Form->label($this->_('DomainResellerApi.tab_actions.field_confirm_domain', true, $domain), 'confirm_domain', ['class' => 'form-label']); ?>
                <?php $this->Form->fieldText('confirm_domain', '', ['id' => 'confirm_domain', 'class' => 'form-control', 'autocomplete' => 'off']); ?>
            </div>
            <?php
            $this->Form->fieldSubmit('delete_immediate', $this->_('DomainResellerApi.tab_actions.field_delete_immediate', true), ['class' => 'btn btn-danger']);
            $this->Form->end();
            ?>
        </div>
    </div>
    <?php
    }

    if (!empty($state['canTransferOut'])) {
        $has_action = true;
    ?>
    <h6 class="form-section-header mt-4"><?php $this->_('DomainResellerApi.tab_actions.heading_transfer_out'); ?></h6>
    <?php if (!empty($transfers)) { ?>
        <?php foreach ($transfers as $transfer) { ?>
    <p><?php $this->_('DomainResellerApi.tab_actions.transfer_out_pending', false, $this->Html->safe($transfer['cr_date'] ?? '')); ?></p>
        <?php } ?>
    <?php } else { ?>
    <p class="text-muted"><?php $this->_('DomainResellerApi.tab_actions.transfer_out_none'); ?></p>
    <?php } ?>
    <div class="d-flex gap-2 mb-3">
        <?php
        foreach (['transfer_out_approve' => 'btn-outline-primary', 'transfer_out_reject' => 'btn-outline-secondary'] as $action => $class) {
            $this->Form->create(null, ['class' => 'd-inline']);
            $this->Form->fieldHidden('action', $action);
            $this->Form->fieldSubmit($action, $this->_('DomainResellerApi.tab_actions.field_' . $action, true), ['class' => 'btn ' . $class]);
            $this->Form->end();
        }
        ?>
    </div>
    <?php
    }

    if (!empty($state['canHold']) || !empty($state['canUnhold'])) {
        $has_action = true;
        $hold = !empty($state['canHold']);
    ?>
    <h6 class="form-section-header mt-4"><?php $this->_('DomainResellerApi.tab_actions.heading_hold'); ?></h6>
    <p class="text-muted"><?php $this->_('DomainResellerApi.tab_actions.hold_description'); ?></p>
    <?php
        $this->Form->create();
        $this->Form->fieldHidden('action', $hold ? 'hold' : 'unhold');
        $this->Form->fieldSubmit($hold ? 'hold' : 'unhold', $this->_($hold ? 'DomainResellerApi.tab_actions.field_hold' : 'DomainResellerApi.tab_actions.field_unhold', true), ['class' => $hold ? 'btn btn-outline-danger' : 'btn btn-primary']);
        $this->Form->end();
    }
    ?>

    <h6 class="form-section-header mt-4"><?php $this->_('DomainResellerApi.tab_actions.heading_sync'); ?></h6>
    <p class="text-muted"><?php $this->_('DomainResellerApi.tab_actions.sync_description'); ?></p>
    <?php
    $this->Form->create();
    $this->Form->fieldHidden('action', 'sync_renew_date');
    $this->Form->fieldSubmit('sync_renew_date', $this->_('DomainResellerApi.tab_actions.field_sync_renew_date', true), ['class' => 'btn btn-outline-secondary']);
    $this->Form->end();

    if (!$has_action) {
    ?>
    <p class="mt-3 text-muted"><em><?php $this->_('DomainResellerApi.tab_actions.no_actions'); ?></em></p>
    <?php } ?>
</div>
